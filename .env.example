# Required for generated answers
OPENROUTER_API_KEY=your-key-here

# Optional settings
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_TIMEOUT=60
RAG_DOCUMENTS_DIR=data/documents
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4
RAG_SEARCH_MODE=hybrid
RAG_SEMANTIC_WEIGHT=0.7
RAG_SEMANTIC_THRESHOLD=0.2
RAG_EMBEDDING_BATCH_SIZE=32
RAG_EMBEDDING_CACHE=.cache/embeddings.json
GRADIO_SERVER_NAME=127.0.0.1
# Uncomment to require a specific port instead of selecting an available one.
# GRADIO_SERVER_PORT=7860
